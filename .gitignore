__pycache__/
*.pyc
*.pyo

# Opt-in diagnostic call-logs (CONFIG__TOOLS.LOG_ENABLED_TOOLS/LOG_DIR) — runtime output,
# never source; regenerated per-machine, not shared across clones.
_logs/

# Outer-repo-only note (ProjectStarter's own __HQ/tools/ folder before this repo is
# cloned into it) — never part of this repo's own content, sits at this path only when
# both repos coexist on disk during development.
/CLONE_TOOLS_HERE.md

# Private test data — real project sources, must NOT be published.
# Kept locally as test fixtures for get_codeblock etc.
test/secret/

# Real external project sources (Warehub etc.) attached to feedback reports as repro
# fixtures — same "must NOT be published" reason as test/secret/ above, just a
# different intake path (feedback reports, not the test suite).
__dev/Requests/feedback/files/

# Scratch output from sweep_invariants.py --write-level (eyeball review copies).
test/LEVELMAP_*.txt

# Scratch output from run_restamp_fixtures.py — the re-stamped copies, for eyeballing.
# The pristine `before` fixtures next to them ARE committed.
test/restamp_fixtures/*/.actual/
